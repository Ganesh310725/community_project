{
  "entities": {
    "User": {
      "title": "User",
      "description": "Base user account profile for donors, receivers, and administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID", "maxLength": 128 },
        "fullName": { "type": "string", "description": "Full name of the user", "maxLength": 100 },
        "email": { "type": "string", "description": "Email address", "maxLength": 150 },
        "role": { "type": "string", "description": "Role in the system", "enum": ["donor", "receiver", "admin"] },
        "phone": { "type": "string", "description": "Contact phone number", "maxLength": 20 },
        "phoneNumber": { "type": "string", "description": "Contact phone number", "maxLength": 20 },
        "state": { "type": "string", "description": "State", "maxLength": 100 },
        "district": { "type": "string", "description": "District", "maxLength": 100 },
        "city": { "type": "string", "description": "City of residence", "maxLength": 100 },
        "pincode": { "type": "string", "description": "Postal code", "maxLength": 10 },
        "pinCode": { "type": "string", "description": "Postal code", "maxLength": 10 },
        "createdAt": { "type": "string", "description": "Server timestamp of account creation" },
        "updatedAt": { "type": "string", "description": "Server timestamp of last update" }
      },
      "required": ["uid", "fullName", "email", "role", "createdAt"]
    },
    "Donor": {
      "title": "Donor",
      "description": "Donor profile containing blood group, location, and availability details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID", "maxLength": 128 },
        "fullName": { "type": "string", "description": "Full name of the donor", "maxLength": 100 },
        "bloodGroup": { "type": "string", "description": "Blood group", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] },
        "phone": { "type": "string", "description": "Phone number", "maxLength": 20 },
        "phoneNumber": { "type": "string", "description": "Phone number", "maxLength": 20 },
        "state": { "type": "string", "description": "State", "maxLength": 100 },
        "district": { "type": "string", "description": "District", "maxLength": 100 },
        "city": { "type": "string", "description": "City", "maxLength": 100 },
        "area": { "type": "string", "description": "Area or Locality", "maxLength": 150 },
        "pincode": { "type": "string", "description": "Postal code", "maxLength": 10 },
        "pinCode": { "type": "string", "description": "Postal code", "maxLength": 10 },
        "lastDonationDate": { "type": "string", "description": "Date of last donation or empty", "maxLength": 20 },
        "availability": { "type": "string", "description": "Current donation availability", "enum": ["Available", "Temporarily Unavailable"] },
        "consentToBeListed": { "type": "boolean", "description": "Consent to appear in donor searches" },
        "searchConsent": { "type": "boolean", "description": "Consent to appear in donor searches" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["uid", "fullName", "bloodGroup", "state", "district", "city", "availability", "createdAt"]
    },
    "ContactRequest": {
      "title": "ContactRequest",
      "description": "Request sent from a receiver to a donor to coordinate blood donation",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "description": "Unique request identifier", "maxLength": 128 },
        "donorUid": { "type": "string", "description": "UID of the donor", "maxLength": 128 },
        "receiverUid": { "type": "string", "description": "UID of the receiver", "maxLength": 128 },
        "receiverName": { "type": "string", "description": "Name of the requesting receiver", "maxLength": 100 },
        "receiverPhone": { "type": "string", "description": "Contact phone of receiver", "maxLength": 20 },
        "receiverEmail": { "type": "string", "description": "Email of receiver", "maxLength": 150 },
        "message": { "type": "string", "description": "Message explaining blood requirement", "maxLength": 1000 },
        "status": { "type": "string", "description": "Status of contact request", "enum": ["pending", "accepted", "rejected"] },
        "donorPhone": { "type": "string", "description": "Revealed donor phone upon acceptance", "maxLength": 20 },
        "donorEmail": { "type": "string", "description": "Revealed donor email upon acceptance", "maxLength": 150 },
        "createdAt": { "type": "string", "description": "Request creation timestamp" },
        "updatedAt": { "type": "string", "description": "Request update timestamp" }
      },
      "required": ["requestId", "donorUid", "receiverUid", "receiverName", "message", "status", "createdAt", "updatedAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User inquiries and feedback submitted via Contact Us page",
      "type": "object",
      "properties": {
        "feedbackId": { "type": "string", "description": "Unique feedback ID", "maxLength": 128 },
        "name": { "type": "string", "description": "Sender name", "maxLength": 100 },
        "email": { "type": "string", "description": "Sender email", "maxLength": 150 },
        "subject": { "type": "string", "description": "Feedback subject", "maxLength": 200 },
        "message": { "type": "string", "description": "Feedback message", "maxLength": 2000 },
        "createdAt": { "type": "string", "description": "Timestamp of submission" }
      },
      "required": ["feedbackId", "name", "email", "subject", "message", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator record for trusted administrative access",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Admin UID", "maxLength": 128 },
        "email": { "type": "string", "description": "Admin Email", "maxLength": 150 },
        "role": { "type": "string", "description": "Admin role", "enum": ["admin"] },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user account profile document containing user role and contact details"
    },
    "/donors/{donorId}": {
      "schema": "Donor",
      "description": "Donor document containing donation availability, blood group, and location"
    },
    "/contactRequests/{requestId}": {
      "schema": "ContactRequest",
      "description": "Contact coordination requests between receivers and donors"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Public user inquiries and contact form submissions"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Designated administrator records for administrative privileges"
    }
  }
}
